 	int			plan_node_id = planstate->plan->plan_node_id;
 	NodeInstrumentation *instrument;
 
-	InstrEndLoop(planstate->instrument);
+	ExecInstrEndLoop(planstate);
 
 	/*
 	 * If we shuffled the plan_node_id values in ps_instrument into sorted
diff --git a/src/backend/executor/execProcnode.c b/src/backend/executor/execProcnode.c
index 7c4c66e..c7bc88f 100644
--- a/src/backend/executor/execProcnode.c
+++ b/src/backend/executor/execProcnode.c
@@ -462,13 +462,54 @@ ExecProcNodeFirst(PlanState *node)
 	 * have ExecProcNode() directly call the relevant function from now on.
 	 */
 	if (node->instrument)
-		node->ExecProcNode = ExecProcNodeInstr;
+	{
+		Instrumentation *instr = &node->instrument->instr;
+
+		if (instr->need_timer || instr->need_bufusage || instr->need_walusage)
+			node->ExecProcNode = ExecProcNodeInstr;
+		else
+		{
+			/*
+			 * Only the row count is needed.  Call the node directly and let
+			 * ExecProcNode() maintain node->instr_rows; ExecInstrEndLoop()
+			 * folds it into node->instrument at the end of each cycle.
+			 */
+			node->instr_rows = INSTR_ROWS_ENABLED;
+			node->ExecProcNode = node->ExecProcNodeReal;
+		}
+	}
 	else
 		node->ExecProcNode = node->ExecProcNodeReal;
 
 	return node->ExecProcNode(node);
 }
 
+/*
+ * ExecInstrEndLoop
+ *
+ * Finish a run cycle of a plan node's instrumentation.  This is
+ * InstrEndLoop() plus folding the row-count-only counter kept in the
+ * PlanState (see ExecProcNode()) into the node's NodeInstrumentation.
+ */
+void
+ExecInstrEndLoop(PlanState *node)
+{
+	NodeInstrumentation *instr = node->instrument;
+	uint64		rows = node->instr_rows;
+
+	if (instr == NULL)
+		return;
+
+	if (rows & INSTR_ROWS_RUNNING)
+	{
+		instr->running = true;
+		instr->tuplecount += (double) (rows & INSTR_ROWS_COUNT_MASK);
+		node->instr_rows = rows & INSTR_ROWS_ENABLED;
+	}
+
+	InstrEndLoop(instr);
+}
+
 
 
