 		planstate->instrument && planstate->instrument->nloops > 0)
@@ -5016,7 +5016,7 @@ show_modifytable_info(ModifyTableState *mtstate, List *ancestors,
 			double		insert_path;
 			double		other_path;
 
-			InstrEndLoop(outerPlanState(mtstate)->instrument);
+			ExecInstrEndLoop(outerPlanState(mtstate));
 
 			/* count the number of source rows */
