 extern void ExecShutdownNode(PlanState *node);
 extern void ExecSetTupleBound(int64 tuples_needed, PlanState *child_node);
+extern void ExecInstrEndLoop(PlanState *node);
 
 /*
  * ExecProcNodeInstr() is implemented in instrument.c, as that allows for
@@ -321,10 +322,23 @@ extern TupleTableSlot *ExecProcNodeInstr(PlanState *node);
 static inline TupleTableSlot *
 ExecProcNode(PlanState *node)
 {
+	TupleTableSlot *result;
+
 	if (node->chgParam != NULL) /* something changed? */
 		ExecReScan(node);		/* let ReScan handle this */
 
-	return node->ExecProcNode(node);
+	result = node->ExecProcNode(node);
+
+	/*
+	 * Row-count-only instrumentation (see ExecProcNodeFirst).  Doing it here,
+	 * on the caller's side, avoids both a wrapper function call per tuple and
+	 * any knowledge of instrumentation in the individual ExecXXX functions.
+	 */
+	if (unlikely(node->instr_rows != 0))
+		node->instr_rows = (node->instr_rows | INSTR_ROWS_RUNNING) +
+			(TupIsNull(result) ? 0 : 1);
+
+	return result;
 }
 #endif
 
