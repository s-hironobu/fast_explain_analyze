@@ -5040,7 +5040,7 @@ show_modifytable_info(ModifyTableState *mtstate, List *ancestors,
 			double		delete_path;
 			double		skipped_path;
 
-			InstrEndLoop(outerPlanState(mtstate)->instrument);
+			ExecInstrEndLoop(outerPlanState(mtstate));
 
 			/* count the number of source rows */
 			total = outerPlanState(mtstate)->instrument->ntuples;
