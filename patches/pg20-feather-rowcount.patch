+	uint64		instr_rows;
+
 	NodeInstrumentation *instrument;	/* Optional runtime stats for this
 										 * node */
 	WorkerNodeInstrumentation *worker_instrument;	/* per-worker
@@ -1277,6 +1285,16 @@ typedef struct PlanState
 #define innerPlanState(node)		(((PlanState *)(node))->righttree)
 #define outerPlanState(node)		(((PlanState *)(node))->lefttree)
 
+/*
+ * Bit layout of PlanState->instr_rows.  Packing the flag, the "running" state
+ * and the counter into one word lets ExecProcNode() update all of them with a
+ * single load and a single store.  62 bits are far more than a double's 53-bit
+ * mantissa can represent exactly anyway.
+ */
+#define INSTR_ROWS_ENABLED		(UINT64CONST(1) << 63)
+#define INSTR_ROWS_RUNNING		(UINT64CONST(1) << 62)
+#define INSTR_ROWS_COUNT_MASK	(INSTR_ROWS_RUNNING - 1)
+
 /* Macros for inline access to certain instrumentation counters */
 #define InstrCountTuples2(node, delta) \
 	do { \
