diff --git a/src/backend/executor/execProcnode.c b/src/backend/executor/execProcnode.c
index 7c4c66e..65a235f 100644
--- a/src/backend/executor/execProcnode.c
+++ b/src/backend/executor/execProcnode.c
@@ -440,6 +440,21 @@ ExecSetExecProcNode(PlanState *node, ExecProcNodeMtd function)
 }
 
 
+/*
+ * Lightweight instrumentation wrapper used when only row counts are needed.
+ * Updates the packed counter in the PlanState; see ExecInstrEndLoop().
+ */
+static TupleTableSlot *
+ExecProcNodeInstrRows(PlanState *node)
+{
+	TupleTableSlot *result = node->ExecProcNodeReal(node);
+
+	node->instr_rows = (node->instr_rows | INSTR_ROWS_RUNNING) +
+		(TupIsNull(result) ? 0 : 1);
+
+	return result;
+}
+
 /*
  * ExecProcNode wrapper that performs some one-time checks, before calling
  * the relevant node method (possibly via an instrumentation wrapper).
@@ -462,13 +477,50 @@ ExecProcNodeFirst(PlanState *node)
 	 * have ExecProcNode() directly call the relevant function from now on.
 	 */
 	if (node->instrument)
-		node->ExecProcNode = ExecProcNodeInstr;
+	{
+		Instrumentation *instr = &node->instrument->instr;
+
+		if (instr->need_timer || instr->need_bufusage || instr->need_walusage)
+			node->ExecProcNode = ExecProcNodeInstr;
+		else
+		{
+			/* Only the row count is needed: use the lightweight wrapper. */
+			node->instr_rows = INSTR_ROWS_ENABLED;
+			node->ExecProcNode = ExecProcNodeInstrRows;
+		}
+	}
 	else
 		node->ExecProcNode = node->ExecProcNodeReal;
 
 	return node->ExecProcNode(node);
 }
 
+/*
+ * ExecInstrEndLoop
+ *
+ * Finish a run cycle of a plan node's instrumentation.  This is
+ * InstrEndLoop() plus folding the row-count-only counter kept in the
+ * PlanState (see ExecProcNodeInstrRows()) into the node's NodeInstrumentation.
+ */
+void
+ExecInstrEndLoop(PlanState *node)
+{
+	NodeInstrumentation *instr = node->instrument;
+	uint64		rows = node->instr_rows;
+
+	if (instr == NULL)
+		return;
+
+	if (rows & INSTR_ROWS_RUNNING)
+	{
+		instr->running = true;
+		instr->tuplecount += (double) (rows & INSTR_ROWS_COUNT_MASK);
+		node->instr_rows = rows & INSTR_ROWS_ENABLED;
+	}
+
+	InstrEndLoop(instr);
+}
+
 
 
