+/*
+ * ExecInstrEndLoop
+ *
+ * Finish a run cycle of a plan node's instrumentation.  This is
+ * InstrEndLoop() plus folding the row-count-only counter kept in the
+ * PlanState (see ExecProcNode()) into the node's NodeInstrumentation.
+ */
+void
+ExecInstrEndLoop(PlanState *node)
+{
+	Instrumentation *instr = node->instrument;
+	uint64		rows = node->instr_rows;
+
+	if (instr == NULL)
+		return;
+
+	if (rows & INSTR_ROWS_RUNNING)
+	{
+		instr->running = true;
+		instr->tuplecount += (double) (rows & INSTR_ROWS_COUNT_MASK);
+		node->instr_rows = rows & INSTR_ROWS_ENABLED;
+	}
+
+	InstrEndLoop(instr);
+}
